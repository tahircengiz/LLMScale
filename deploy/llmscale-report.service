[Unit]
Description=LLMScale weekly traffic digest
Documentation=https://github.com/tahircengiz/LLMScale/blob/main/docs/traffic-report.md
After=docker.service homelab-mailer.service
Wants=docker.service

[Service]
Type=oneshot
# Root because the job reads the mailer's env file and drives docker.
User=root
Environment=DAYS=7
ExecStart=/home/blue/projects/infra-llmscale-report/run.sh
# A failed run must be visible, not silent: the digest's absence is the signal.
StandardOutput=journal
StandardError=journal
