[Unit]
Description=Mail the LLMScale traffic digest every Monday morning

[Timer]
# The box runs UTC; state the zone so the digest lands at 08:00 local whatever
# the host clock is set to. systemd 255 supports the suffix.
OnCalendar=Mon *-*-* 08:00:00 Europe/Istanbul
# If the box was off on Monday, still send it when it comes back.
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
