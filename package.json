{
  "name": "llmscale",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Estimate the VRAM an LLM needs \u2014 weights, KV cache, context window, concurrent users \u2014 and find the right GPU.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.ts dist dist-ssr && node scripts/genPages.ts dist && node scripts/sitemap.ts dist && node scripts/llmsTxt.ts dist",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node scripts/test-calc.ts",
    "test:invariants": "node scripts/test-invariants.ts",
    "test:devicegrid": "node scripts/test-devicegrid.ts",
    "test:perf": "node scripts/test-perf.ts",
    "test:train": "node scripts/test-train.ts",
    "deploy": "gh-pages -d dist --dotfiles",
    "test:traffic": "node scripts/test-traffic.ts",
    "report": "node scripts/report-traffic.ts",
    "test:mla": "node scripts/test-mla.ts",
    "test:langpath": "node scripts/test-langpath.ts",
    "test:moe": "node scripts/test-moe.ts",
    "test:fit": "node scripts/test-fit.ts",
    "test:vllm": "node scripts/test-vllm.ts",
    "test:anatomy": "node scripts/test-anatomy.ts",
    "test:modelname": "node scripts/test-modelname.ts",
    "test:theme": "node scripts/test-theme.ts",
    "test:config": "node scripts/test-config.ts",
    "test:all": "for f in scripts/test-*.ts; do echo \"== $f\"; node \"$f\" > /dev/null || { node \"$f\" | grep FAIL; exit 1; }; done && echo \"ALL SUITES PASS\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
